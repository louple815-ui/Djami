<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DJAMI"
            android:textColor="#1B5E20"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prêt à vous servir"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Écrivez ou dictez votre texte (FR, EN, DE)..."
            android:padding="16dp"
            android:background="#F5F5F5"
            android:textColor="#333333"
            android:gravity="top|start"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/btn_gold"
            android:text="Analyser et Corriger"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#333333"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnSpeak"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/btn_glass"
            android:text="🎤 Parler à DJAMI"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnWakeMode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#1B5E20"
            android:text="🧠 Mode Jarvis (Écoute en fond)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
